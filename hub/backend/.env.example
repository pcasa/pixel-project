# Copy to .env in this directory (or set OMNIBOT_DATA_DIR and place .env there).
# Environment variables override values stored in hub_secrets.json via the Hub settings UI.

# ─── Required ─────────────────────────────────────────────────────────────────

# Claude API key (brain / reasoning / memory). Get yours at console.anthropic.com.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Gemini API key (speech-to-text + text-to-speech only). Free tier. Get yours at aistudio.google.com.
GEMINI_API_KEY=your_gemini_key_here

# ─── Optional ─────────────────────────────────────────────────────────────────

# Required for OpenStreetMap Nominatim (geocoding postal + country into lat/lng for Maps grounding).
# Use a stable app name + contact URL or email per https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_USER_AGENT=PixelHub/1.0 (your-email@example.com)

# TTS voice name (Gemini prebuilt voices: Umbriel, Puck, Kore, Charon, Fenrir, Aoede).
# Default: Umbriel
# OMNIBOT_TTS_VOICE=Umbriel

# TTS model override. Default: gemini-2.0-flash-exp
# OMNIBOT_TTS_MODEL=gemini-2.0-flash-exp

# Optional: absolute path for bot_settings.json, known_bots.json, hub_secrets.json, etc.
# Default: directory containing app.py
# OMNIBOT_DATA_DIR=

# Optional: bind address and port for uvicorn (defaults: 0.0.0.0, 8000).
# HOST=0.0.0.0
# PORT=8000

# Optional: serve a production Vite build from this directory (same origin as API). Used by Docker image.
# OMNIBOT_STATIC_ROOT=/app/backend/static
